    "paywall.trialDetails": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free receipt. Access starts on first open for 30 days. Claiming the receipt doesn’t restart the trial. There’s no automatic charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证免费。首次打开起试用 30 天，领取凭证不会重启试用，到期不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證免費。首次開啟起試用 30 天，領取憑證不會重啟試用，到期不會自動扣款。"
          }
